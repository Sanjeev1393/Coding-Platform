# ------------------------------------------------------------------------------
# Backend Environment Configuration Template
# Copy to .env or configure in your deployment platform (e.g. Render Dashboard)
# ------------------------------------------------------------------------------

# Server Port (Render sets this dynamically at runtime)
PORT=8080

# Execution Provider ('piston' for local Docker, 'jdoodle' for cloud deployment)
EXECUTION_PROVIDER=piston

# JDoodle API Credentials (Required when EXECUTION_PROVIDER=jdoodle)
JDOODLE_CLIENT_ID=your_jdoodle_client_id_here
JDOODLE_CLIENT_SECRET=your_jdoodle_client_secret_here

# Cross-Origin Resource Sharing (comma-separated allowed frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Optional MongoDB Connection String (For future persistence layer)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/coding-platform
