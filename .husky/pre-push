echo "🔍 Running pre-push checks (tests & build)..."
cd frontend || exit 1

echo "🧪 Step 1/2: Running test suite (npm run test:run)..."
npm run test:run || {
  echo "❌ Tests failed. Push aborted. Please fix failing tests before pushing."
  exit 1
}

echo "📦 Step 2/2: Verifying production build (npm run build)..."
npm run build || {
  echo "❌ Build failed. Push aborted. Please fix build errors before pushing."
  exit 1
}

echo "✅ All pre-push checks passed (tests & build). Proceeding with push."
