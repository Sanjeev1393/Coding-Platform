echo "🎨 Step 1/2: Running backend format (spotless:apply)..."
(cd backend && ./mvnw spotless:apply) || {
  echo "❌ Backend formatting with Spotless failed. Commit aborted."
  exit 1
}

# Automatically stage any formatted backend files
git add -u backend

echo "🔍 Step 2/2: Running frontend lint check..."
(cd frontend && npm run lint) || {
  echo "❌ Linting failed. Commit aborted. Please fix lint errors before committing."
  exit 1
}

echo "✅ All pre-commit checks passed."
